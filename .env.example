# === Arc Mainnet Configuration ===
# 
# IMPORTANT: Arc Mainnet has two distinct USDC concepts:
#   1. NATIVE GAS USDC - the native gas token used to pay transaction fees.
#      This is NOT an ERC-20 token. You must have a non-zero native balance
#      to pay for gas on Arc.
#   2. ERC-20 USDC - the fungible token at 0x3600...0000 used by EscrowAI.
#      These are technically different: native gas USDC is the chain's gas
#      currency, while the ERC-20 at the address below is the token passed
#      to EscrowAI's constructor.
#
# Chain ID: 5042

# --- Frontend (public, safe to expose) ---
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io
NEXT_PUBLIC_ARC_CHAIN_ID=5042
# ERC-20 USDC used by EscrowAI (not the native gas token)
NEXT_PUBLIC_ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_ESCROW_CONTRACT_ADDRESS=0x84141727973c3A74844a51c058f199A82F12464f

# --- Backend / Deploy script (Milestone 1) ---
ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_CHAIN_ID=5042
# Deployed EscrowAI contract address on Arc Mainnet
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ESCROW_CONTRACT_ADDRESS=0x84141727973c3A74844a51c058f199A82F12464f

# --- Deployment (Milestone 1 — do not change unless reviewing) ---
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_MAINNET_CHAIN_ID=5042

# Set only for a reviewed deployment.
# ALLOW_ARC_MAINNET_DEPLOY=true
# PRIVATE_KEY=0x...

# Optional token override. Defaults to Arc Mainnet USDC when no override is set.
# USDC_TOKEN_ADDRESS=0x3600000000000000000000000000000000000000

# Local development only.
# DEPLOY_MOCK_USDC=true
